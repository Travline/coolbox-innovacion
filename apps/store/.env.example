# Dirección pública de la API del asistente.
VITE_API_URL=http://localhost:3001

# Acceso de lectura desde el navegador. Cualquier token VITE_ es público:
# usar exclusivamente una credencial de lectura cuyo alcance haya sido verificado.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=

# Destino del proxy /api/ml en Vite y Vercel. Configurar como variable de servidor.
ML_API_URL=http://localhost:8000

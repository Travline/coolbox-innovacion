# Credenciales de demostración. Usar correos y contraseñas distintos.
ADMIN_EMAIL=
ADMIN_PASS=
DEV_EMAIL=
DEV_PASS=
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
ML_SESSION_SECRET=
ML_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# true en HTTPS. Cambiar a false únicamente para desarrollo local sobre HTTP.
ML_COOKIE_SECURE=true

# Ejecución con Turso y Supabase. Aplicar primero la migración 004.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
S3_ENDPOINT_URL=https://your-project.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_BUCKET=coolbox-models
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Modo local opcional. Solo si se definen ambas variables se puede entrenar
# con el catálogo JSON sin configurar servicios externos.
ML_LOCAL_DIR=
ML_CATALOG_SNAPSHOT=
# Render define PORT automáticamente.
PORT=8000

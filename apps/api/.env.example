# Token de solo lectura para el catálogo; nunca utilizar la credencial del loader.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
PORT=3001
# Modelo del asistente: la clave permanece solo en el servidor.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
# Orígenes de tienda autorizados, separados por comas. En producción usa solo los reales.
STORE_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Opcional: carpeta escribible para caché de embeddings. En Vercel se usa /tmp.
MODEL_CACHE_DIR=

# Canales públicos: completar solo tras revisión para el día de la presentación (hora de Perú).
# CONTACTS_PRESENTATION_DATE y CONTACTS_CHECKED_AT deben ser la fecha vigente AAAA-MM-DD.
CONTACTS_PRESENTATION_DATE=
CONTACTS_CHECKED_AT=
CONTACTS_WHATSAPP=
CONTACTS_EMAIL=
